# Base URL of Dokploy. Inside the server network use http://dokploy:3000; for local development use the Tailscale address.
DOKPLOY_URL=
# Dokploy API key for the panel (create it with rateLimitEnabled:false). Server-side only, never commit the real value.
DOKPLOY_API_KEY=

# Panel backend (packages/backend)
# PORT=3000
# HOST=0.0.0.0
# DATA_DIR=./data
# LOG_LEVEL=info
# DOKPLOY_TIMEOUT_MS=10000
# Extra protected names, comma separated. The built-in ones (infra, mcp-gateway, homeserver-panel and the key names
# claude-code, remote-test, homeserver-panel, deploy-cli) are always protected and cannot be removed here.
# PROTECTED_PROJECT_NAMES=
# PROTECTED_KEY_NAMES=
